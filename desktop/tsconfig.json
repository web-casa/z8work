{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["vite/client"],
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
