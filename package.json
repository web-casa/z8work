{
	"name": "z8-work",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
		"build:pages": "node scripts/build-pages.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "node --test tests/*.test.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"lint:changed": "node scripts/lint-changed.mjs",
		"test:browser": "node tests/browser/run.mjs",
		"test:pages": "node tests/browser/pages-engines.mjs",
		"test:seo": "node tests/seo-build.mjs",
		"desktop:frontend": "vite --config desktop/vite.config.ts",
		"desktop:build": "vite build --config desktop/vite.config.ts",
		"desktop:test:preferences": "node scripts/desktop-preferences-gui.mjs",
		"desktop:test:quit": "node scripts/desktop-quit-gui.mjs",
		"desktop:test:preview": "node scripts/desktop-preview-gui.mjs",
		"desktop:test:pdf-preview": "node scripts/desktop-preview-gui.mjs --pdf",
		"desktop:test:media-preview": "node scripts/desktop-preview-gui.mjs --media",
		"desktop:test:startup-benchmark": "node scripts/desktop-preview-gui.mjs --startup-benchmark-only",
		"desktop:test:product": "node scripts/desktop-preview-gui.mjs --product",
		"desktop:smoke:phase27": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p z8-native --features development-engines --bin smoke -- --phase27",
		"desktop:test:startup": "node scripts/desktop-preview-gui.mjs --startup",
		"desktop:test:save-retry": "node scripts/desktop-preview-gui.mjs --save-retry",
		"desktop:test:diagnostics": "node scripts/desktop-preview-gui.mjs --diagnostics",
		"desktop:test:storage": "node scripts/desktop-preview-gui.mjs --storage",
		"desktop:test:workspaces": "node scripts/desktop-preview-gui.mjs --workspaces",
		"desktop:test:imports": "node scripts/desktop-preview-gui.mjs --imports",
		"desktop:check": "svelte-check --workspace desktop --tsconfig tsconfig.json",
		"desktop:dev": "tauri dev --features development-engines",
		"desktop:prepare": "node scripts/desktop-prepare.mjs",
		"desktop:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml -p z8-native --features development-engines",
		"desktop:smoke": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p z8-native --features development-engines --bin smoke",
		"desktop:gui:smoke": "node scripts/desktop-gui-smoke.mjs",
		"desktop:test:lifecycle": "cargo test --locked --manifest-path src-tauri/Cargo.toml -p z8-native --no-default-features process::",
		"desktop:test:ui": "node --test desktop/tests/*.test.mjs",
		"desktop:test:gui": "node scripts/desktop-phase1-gui.mjs",
		"desktop:smoke:phase2": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p z8-native --features development-engines --bin smoke -- --phase2",
		"desktop:test:gui:phase2": "node scripts/desktop-phase1-gui.mjs --phase2",
		"desktop:bundle:linux": "node scripts/desktop-bundle-linux.mjs",
		"desktop:candidate:linux": "node scripts/desktop-candidate-linux.mjs",
		"desktop:bundle:check": "cargo run --locked --manifest-path src-tauri/Cargo.toml -p z8-native --features engine-validation --bin bundle-check",
		"desktop:test:gui:phase3": "node scripts/desktop-phase1-gui.mjs --phase2 --packaged",
		"desktop:candidate:check": "node scripts/desktop-candidate-check.mjs",
		"desktop:bundle:isolated": "node scripts/desktop-bundle-isolated.mjs",
		"desktop:store:prepare": "node scripts/desktop-store.mjs",
		"desktop:store:pages": "node scripts/desktop-store.mjs --write-pages",
		"desktop:store:check": "node scripts/desktop-store.mjs --check-pages",
		"desktop:store:ready": "node scripts/desktop-store.mjs --check-pages --require-ready",
		"desktop:test:store-pages": "node scripts/desktop-store-browser.mjs",
		"desktop:store:verify-pages": "node scripts/desktop-store-verify-pages.mjs",
		"desktop:sources:audit": "node scripts/desktop-sources.mjs",
		"desktop:sources:fetch": "node scripts/desktop-source-fetch.mjs",
		"desktop:sources:snapshot": "node scripts/desktop-source-snapshot.mjs",
		"desktop:sources:assemble": "node scripts/desktop-source-assemble.mjs",
		"desktop:snap:prepare": "node scripts/desktop-snap-prepare.mjs",
		"desktop:snap:check": "node scripts/desktop-snap-check.mjs",
		"desktop:snap:pack": "node scripts/desktop-snap-pack.mjs",
		"desktop:snap:installed": "node scripts/desktop-snap-installed.mjs",
		"desktop:snap:handoff": "node scripts/desktop-snap-handoff.mjs",
		"desktop:windows:check": "node scripts/desktop-windows-check.mjs",
		"desktop:bundle:windows": "node scripts/desktop-bundle-windows.mjs",
		"desktop:windows:engines:check": "node scripts/desktop-windows-engines-check.mjs",
		"desktop:windows:handoff": "node scripts/desktop-windows-handoff.mjs",
		"desktop:windows:acceptance": "node scripts/desktop-windows-acceptance.mjs",
		"desktop:msix:assets": "node scripts/desktop-msix-assets.mjs",
		"desktop:msix:prepare": "node scripts/desktop-msix-prepare.mjs",
		"desktop:msix:pack": "node scripts/desktop-msix-pack.mjs",
		"desktop:msix:acceptance": "node scripts/desktop-msix-acceptance.mjs",
		"desktop:versions": "node scripts/desktop-versions.mjs",
		"desktop:candidate:macos": "node scripts/desktop-candidate-macos.mjs",
		"desktop:notices": "node scripts/desktop-notices.mjs",
		"desktop:bundle:macos": "node scripts/desktop-bundle-macos.mjs"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.5.0",
		"@poppanator/sveltekit-svg": "^5.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tauri-apps/cli": "2.11.4",
		"@types/dompurify": "^3.2.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22",
		"autoprefixer": "^10.4.22",
		"css-select": "5.1.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"playwright": "1.62.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sass": "^1.94.2",
		"svelte": "^5.43.14",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^5.4.21",
		"vite-plugin-top-level-await": "^1.6.0",
		"yaml": "2.8.2"
	},
	"dependencies": {
		"@bjorn3/browser_wasi_shim": "^0.4.2",
		"@ffmpeg/core": "0.12.10",
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@fontsource-variable/pixelify-sans": "5.3.0",
		"@fontsource/azeret-mono": "^5.2.11",
		"@fontsource/lexend": "^5.2.11",
		"@fontsource/radio-canada-big": "^5.2.7",
		"@imagemagick/magick-wasm": "^0.0.43",
		"@tauri-apps/api": "2.11.1",
		"byte-data": "^19.0.1",
		"client-zip": "^2.5.0",
		"clsx": "^2.1.1",
		"fflate": "^0.8.2",
		"isomorphic-dompurify": "^2.35.0",
		"mupdf": "1.28.1",
		"music-metadata": "^11.10.3",
		"overlayscrollbars": "^2.12.0",
		"overlayscrollbars-svelte": "^0.5.5",
		"p-queue": "^9.0.1",
		"pixelarticons": "2.4.1",
		"riff-file": "^1.0.3",
		"vert-wasm": "^0.0.2",
		"vite-plugin-wasm": "^3.5.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"@swc/core"
	]
}
